{
  "name": "vite-plugin-keyhole",
  "version": "0.0.0",
  "description": "Encrypt a whole Vite build so it opens only with a link key or a password",
  "license": "MIT",
  "keywords": [
    "vite",
    "vite-plugin",
    "encryption",
    "password-protect",
    "github-pages",
    "static-site"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "keyhole": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "tsdown && vitest run",
    "vectors": "node test/make-vectors.mjs > test/vectors.json"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
